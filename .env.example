# Application
PORT=3000

# Storage driver: "json" (default, zero setup, data/catalog.json) or "mysql"
# (durable relational database, see db/mysql-schema.sql). Switch to mysql for
# the submission/evaluation deployment so the platform genuinely "stores data
# in its own database" per the assignment brief.
DB_DRIVER=json
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=catalog_maker
DB_USER=root
DB_PASSWORD=

ADMIN_PASSWORD=CatalogAdmin@2026
SESSION_SECRET=CatalogMakerSessionSecret_2026_SecureKey_123456789
PUBLIC_BASE_URL=http://localhost:3000

# Shopify Admin API (custom app access token). For the examination, configure a real
# Shopify development/test store containing at least 50 products. If left unset,
# the local 50-product demonstration dataset is used.
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxx
SHOPIFY_API_VERSION=2025-01

# WooCommerce REST API. For the examination, configure a real WordPress/WooCommerce
# test store containing at least 50 products. If left unset, the local 50-product
# demonstration dataset is used.
WOO_BASE_URL=https://your-store.com
WOO_CONSUMER_KEY=ck_xxxxxxxxx
WOO_CONSUMER_SECRET=cs_xxxxxxxxx
